{
  "info": {
    "name": "PEID - Ficha 7/8 - BaseX RESTXQ",
    "description": "Coleção para testar os endpoints RESTXQ do BaseX",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Parte 1 - API ip-fast.com",
      "item": [
        {
          "name": "1a) IP sem parâmetros",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://ip-fast.com/api/ip/",
              "protocol": "https",
              "host": ["ip-fast", "com"],
              "path": ["api", "ip", ""]
            }
          }
        },
        {
          "name": "1b) IP com location=true",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://ip-fast.com/api/ip/?location=true",
              "protocol": "https",
              "host": ["ip-fast", "com"],
              "path": ["api", "ip", ""],
              "query": [{"key": "location", "value": "true"}]
            }
          }
        },
        {
          "name": "1c) IP com location=true e format=json",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://ip-fast.com/api/ip/?location=true&format=json",
              "protocol": "https",
              "host": ["ip-fast", "com"],
              "path": ["api", "ip", ""],
              "query": [
                {"key": "location", "value": "true"},
                {"key": "format", "value": "json"}
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Parte 2 - RESTXQ BaseX",
      "item": [
        {
          "name": "Ex 1a) Soma com valores no URL",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8984/soma/15/7",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8984",
              "path": ["soma", "15", "7"]
            }
          }
        },
        {
          "name": "Ex 1b) Soma com query parameters",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8984/soma?number1=25&number2=30",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8984",
              "path": ["soma"],
              "query": [
                {"key": "number1", "value": "25"},
                {"key": "number2", "value": "30"}
              ]
            }
          }
        },
        {
          "name": "Ex 2) Contar livros (POST)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/xml"}],
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<bookstore>\n  <book category=\"cooking\">\n    <title lang=\"en\">Everyday Italian</title>\n    <author>Giada De Laurentiis</author>\n    <year>2005</year>\n    <price>30.00</price>\n  </book>\n  <book category=\"children\">\n    <title lang=\"en\">Harry Potter</title>\n    <author>J K. Rowling</author>\n    <year>2005</year>\n    <price>29.99</price>\n  </book>\n  <book category=\"web\">\n    <title lang=\"en\">XQuery Kick Start</title>\n    <author>James McGovern</author>\n    <year>2003</year>\n    <price>49.99</price>\n  </book>\n  <book category=\"web\">\n    <title lang=\"en\">Learning XML</title>\n    <author>Erik T. Ray</author>\n    <year>2003</year>\n    <price>39.95</price>\n  </book>\n</bookstore>"
            },
            "url": {
              "raw": "http://localhost:8984/livros/contar",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8984",
              "path": ["livros", "contar"]
            }
          }
        }
      ]
    }
  ]
}